  "publicInitialization": {
    "retrievals": {
      "v8": 1,
      "node:diagnostics_channel": 1
    },
    "tracingNames": [
      "mongoose:cursor:next",
      "mongoose:aggregate",
      "mongoose:query",
      "mongoose:model:save",
      "mongoose:model:insertMany",
      "mongoose:model:bulkWrite"
    ],
    "eachTracingNameCalls": 1,
    "v8": "Only startupSnapshot.isBuildingSnapshot bound to real native; require exact primitive positive zero via Object.is(result, 0) and return native result unchanged; no coercion, Boolean false union, callback or other property authority",
    "diagnostics": "Only real tracingChannel projected with exact six names, once each, only within synchronous init window",
    "window": "reflect-metadata -> typedi -> mongoose require, closes in finally before domain import; retained projected methods check same window; all unknown/later calls latch even if caught",
    "trapsBeforePublicImports": true
  },
  "ownedConnection": {
    "uri": "mongodb://127.0.0.1:27017/sd_iq_<nonce>?replicaSet=sd_iq_rs_<nonce>&directConnection=true",
    "options": {
      "autoIndex": false,
      "autoCreate": false,
      "serverSelectionTimeoutMS": 5000,
      "connectTimeoutMS": 5000,
      "socketTimeoutMS": 10000,
      "maxPoolSize": 4,
      "minPoolSize": 0,
      "monitorCommands": true,
      "retryReads": false,
      "retryWrites": false,
      "maxAdaptiveRetries": 0
    },
    "bufferCommands": false,
    "runtimeAdaptersOS": [
      "platform",
      "arch",
      "release",
      "type"
    ],
    "adapterProof": "Actual client.options.runtimeAdapters.os exact four own data keys with same captured native function refs; await client.options.runtime exact {os} and resolved.os===actual adapter; freeze ACTUAL cloned adapter and runtimeAdapters record, not just original. Validate before native connect in owned prototype wrapper and recheck after mongoose.connect. No original-object-identity requirement.",
    "dynamicImportPolicy": "Fixed native OS projection prevents pinned resolver default import(os) branch; CJS hooks are not claimed as generic ESM enforcement. All domain source/emitted code rejects dynamic loading/codegen/builtin retrieval."
  },
  "sessions": {
    "options": {
      "causalConsistency": false
    },
    "transactionOptions": {
      "readPreference": "primary",
      "readConcern": {
        "level": "snapshot"
      },
      "writeConcern": {
        "w": "majority",
        "wtimeoutMS": 5000
      },
      "maxCommitTimeMS": 5000
    },
    "actionSessions": 163,
    "controlSession": "one explicit held own-client session, distinct from active action session; all snapshots/setup/cleanup controls use it",
    "firstTxnAction": "find has held lsid+BSON Long txnNumber/autocommit:false/startTransaction:true/readConcern snapshot; subsequent save same lsid/txnNumber, no startTransaction or per-operation writeConcern",
    "directConnectionEnvelope": "Driver may add exact $readPreference:{mode:primaryPreferred}, $db and typed $clusterTime gossip; do not equate APM with all handshakes.",
    "nominalTerminal": "five selected terminal commands, each one started+matching succeeded ok1, zero failed/writeConcernError/extra attempts; after abort compare return to pre-abort own-session state and persisted final to baseline",
    "failureCleanup": "no further cases/retries; at most one explicit abort API per still-active owned transaction, bounded driver-internal retry may add at most two wire abort attempts; record and never pass; preserve first failure; unresolved cleanup is terminal",
    "endSessions": "client close may emit at most one admin endSessions with only held/observed own-client session IDs; all transactions terminal/cursors exhausted first; do not claim wire endSession or endSessions acknowledgement absent evidence"
  },
  "commandPhases": {
    "CONNECT": [
      "one fixed hello:1 owned setName/isWritablePrimary proof",
      "one typed admin.serverInfo -> buildinfo:1 version8.0.34"
    ],
    "INDEX_SETUP": [
      "listCollections empty before creation",
      "three create",
      "22 single-index createIndexes",
      "three complete listIndexes, exact25 rows incl implicit_id",
      "listCollections exactthree afterwards"
    ],
    "CASE_SETUP": [
      "three complete empty snapshots BEFORE eligibility",
      "three explicit non-lean Model.insertMany calls, normally four documents (twoitems+adjustment+reservation), fewer only when target intentionally absent",
      "baseline snapshot/metadata assertion outside action"
    ],
    "ACTION": [
      "exact find/write counts in cases.json, Item only; exact pharmacy/medicine filter; update one nonmulti/nonupsert statement with _id/__v0 and increment1; insert only three explicit new-item cases; no aggregate/populate/other collection/admin command"
    ],
    "CONTROL": [
      "bounded complete find snapshots on three collections, exact held client/session/cursor; optional getMore ONLY if independently bound owned cursor; normally cursorid0 with batchSize100",
      "manual transaction inside/outside reads and exact selected terminal commands counted separately"
    ],
    "CASE_CLEANUP": [
      "only exact eligible IDs, three bounded delete commands; absent negative IDs never eligible; newly source-created IDs require exact owned-tuple/returned/store proof first",
      "three complete empty snapshots before next case"
    ],
    "CLOSE": [
      "all sessions terminal/ended and cursors exhausted, then mongoose disconnect/driver endSessions at mostonce with ownIDs; no hidden success after failed command"
    ]
  },
