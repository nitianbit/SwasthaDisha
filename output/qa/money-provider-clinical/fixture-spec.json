  "denial_invariants": "For every denied request: wallet documents equal the pre-request snapshot including updatedAt, zero new walletTransactions, notifications or task rows, and zero calls on every recording port",
  "cases": [
    {"id": "DEN-01", "kind": "denial", "actor": "PATIENT_A", "request": {"method": "POST", "path": "/api/v1/wallet/transactions", "body": {"userId": "aaaaaaaaaaaaaaaaaaaa0001", "transactionType": "credit", "amount": 500}}, "expect": {"status": 403, "code": "FORBIDDEN", "A_balance": 0}},
    {"id": "DEN-02", "kind": "denial", "actor": "PATIENT_A", "request": {"method": "POST", "path": "/api/v1/wallet/transactions", "body": {"userId": "aaaaaaaaaaaaaaaaaaaa0002", "transactionType": "credit", "amount": 500}}, "expect": {"status": 403, "code": "FORBIDDEN", "B_balance": 250}},
    {"id": "DEN-03", "kind": "denial", "actor": "PATIENT_A", "request": {"method": "POST", "path": "/api/v1/wallet/transactions", "body": {"userId": "aaaaaaaaaaaaaaaaaaaa0002", "transactionType": "debit", "amount": 100}}, "expect": {"status": 403, "code": "FORBIDDEN", "B_balance": 250}},
    {"id": "DEN-04", "kind": "denial", "actor": "PATIENT_A", "variants": ["refund", "cashback", "promotion"], "request": {"method": "POST", "path": "/api/v1/wallet/transactions", "body": {"userId": "aaaaaaaaaaaaaaaaaaaa0001", "transactionType": "<variant>", "amount": 500}}, "expect": {"status": 403, "code": "FORBIDDEN", "A_balance": 0}},
    {"id": "DEN-05", "kind": "denial", "actor": "PATIENT_A", "request": {"method": "POST", "path": "/api/v1/wallet", "body": {"userId": "aaaaaaaaaaaaaaaaaaaa0003", "initialBalance": 500}}, "expect": {"status": 403, "code": "FORBIDDEN", "C_wallet_exists": false}},
    {"id": "DEN-06", "kind": "denial", "actor": "PATIENT_A", "request": {"method": "POST", "path": "/api/v1/wallet", "body": {"userId": "aaaaaaaaaaaaaaaaaaaa0001"}}, "expect": {"status": 403, "code": "FORBIDDEN"}, "note": "Client-compatibility probe; own wallets are still created by login and GET /user/:userId"},
    {"id": "DEN-07", "kind": "denial", "actors": ["HR_H", "SPECIALIST_S", "PHARMACY_P"], "requests": ["DEN-01 body with actor's own _id", "DEN-02 body", "DEN-05 body"], "expect": {"status": 403, "code": "FORBIDDEN"}},
    {"id": "DEN-08", "kind": "denial", "actor": "PATIENT_A", "request": {"method": "POST", "path": "/api/v1/wallet/transactions", "body": {"userId": "aaaaaaaaaaaaaaaaaaaa0001", "transactionType": "mint", "amount": -1}}, "expect": {"status": 403, "code": "FORBIDDEN"}, "note": "Authority precedes validation; 400 means the guard is after validate"},
    {"id": "DEN-09", "kind": "denial", "actor": "PATIENT_A", "request": {"method": "POST", "path": "/api/v1/wallet/transactions", "body": {"userId": "aaaaaaaaaaaaaaaaaaaa0001", "transactionType": "credit", "amount": 500, "userType": "admin", "isAdmin": true}}, "expect": {"status": 403, "code": "FORBIDDEN"}},
    {"id": "DEN-10", "kind": "denial", "token": "none", "routes": ["POST /api/v1/wallet/transactions", "POST /api/v1/wallet"], "expect": {"status": 401, "code": "UNAUTHORIZED"}},
    {"id": "DEN-11", "kind": "denial", "token": "wrong_key_admin", "routes": ["POST /api/v1/wallet/transactions", "POST /api/v1/wallet"], "expect": {"status": 401, "code": "INVALID_TOKEN"}},
    {"id": "DEN-12", "kind": "denial", "token": "expired_admin", "routes": ["POST /api/v1/wallet/transactions", "POST /api/v1/wallet"], "expect": {"status": 401, "code": "TOKEN_EXPIRED"}},
    {"id": "SUC-01", "kind": "success_preserved", "actor": "ADMIN_X", "request": {"method": "POST", "path": "/api/v1/wallet/transactions", "body": {"userId": "aaaaaaaaaaaaaaaaaaaa0002", "transactionType": "credit", "amount": 100, "referenceType": "fixture_adjustment"}}, "expect": {"status": 201, "B_balance": 350, "new_transactions_B": 1, "new_notifications_B": 1, "provider_calls": 0}, "note": "Baseline behaviour preserved; not evidence of approved funded/audited admin authority"},
    {"id": "SUC-02", "kind": "success_preserved", "actor": "ADMIN_X", "request": {"method": "POST", "path": "/api/v1/wallet/transactions", "body": {"userId": "aaaaaaaaaaaaaaaaaaaa0002", "transactionType": "debit", "amount": 50}}, "expect": {"status": 201, "B_balance": 200, "new_transactions_B": 1, "new_notifications_B": 0}},
    {"id": "SUC-03", "kind": "success_preserved", "actor": "ADMIN_X", "request": {"method": "POST", "path": "/api/v1/wallet", "body": {"userId": "aaaaaaaaaaaaaaaaaaaa0003", "initialBalance": 50}}, "expect": {"status": 201, "C_balance": 50, "new_transactions_C": 1, "transaction_referenceType": "initial"}},
    {"id": "SUC-04", "kind": "success_preserved", "actor": "ADMIN_X", "request": {"method": "POST", "path": "/api/v1/wallet/transactions", "body": {"userId": "aaaaaaaaaaaaaaaaaaaa0002", "transactionType": "mint", "amount": -1}}, "expect": {"status": 400, "B_balance": 250}, "note": "Admin validation behaviour unchanged"},
    {"id": "SUC-05", "kind": "unchanged_surface", "actor": "PATIENT_A", "request": {"method": "POST", "path": "/api/v1/wallet/recharge/initiate", "body": {"amount": 100}}, "expect": {"status": 200, "razorpay_order_port_calls": 1, "A_balance": 0, "payment_record_status": "created"}},
    {"id": "SUC-06", "kind": "unchanged_surface", "actor": "PATIENT_A", "request": {"method": "GET", "path": "/api/v1/wallet/user/aaaaaaaaaaaaaaaaaaaa0001"}, "expect": {"status": 200, "A_balance": 0}},
    {"id": "SUC-07", "kind": "unchanged_surface", "actor": "USER_C_NO_WALLET", "request": {"method": "POST", "path": "/api/v1/referrals/apply", "body": {"referralCode": "<PATIENT_A synthetic referral code>"}}, "precondition": "Synthetic referral code for PATIENT_A and a configured synthetic reward amount", "expect": {"A_new_promotion_transactions": 1, "wallet_route_invoked": false}, "note": "In-process WalletService.addTransaction remains reachable"},
    {"id": "RPL-01", "kind": "replay", "actor": "PATIENT_A", "steps": "Send the DEN-01 request three times with identical body", "expect": {"each_status": 403, "A_balance": 0, "new_transactions": 0}},
    {"id": "RPL-02", "kind": "replay", "actor": "PATIENT_A", "steps": "Send the DEN-05 request twice", "expect": {"each_status": 403, "C_wallet_exists": false}},
    {"id": "RPL-03", "kind": "replay_observation", "actor": "ADMIN_X", "steps": "Send the SUC-01 request twice", "observe": "Two credits are expected from unchanged non-idempotent baseline", "classification": "KNOWN_DEFECT_UNCHANGED_F11", "acceptance": false},
    {"id": "RACE-01", "kind": "race", "actor": "PATIENT_A", "steps": "Twenty concurrent requests mixing DEN-01, DEN-02 and DEN-03 bodies", "expect": {"all_status": 403, "A_balance": 0, "B_balance": 250, "new_transactions": 0, "provider_calls": 0}},
    {"id": "RACE-02", "kind": "race", "actors": ["ADMIN_X", "PATIENT_A"], "steps": "Concurrently: SUC-01 by ADMIN_X and DEN-02 by PATIENT_A", "expect": {"admin_status": 201, "patient_status": 403, "B_balance": 350, "new_transactions_B": 1}},
    {"id": "RACE-03", "kind": "race", "actor": "PATIENT_A", "steps": "Ten concurrent DEN-05 requests", "expect": {"all_status": 403, "C_wallet_exists": false}},
    {"id": "RACE-04", "kind": "race_observation", "actor": "ADMIN_X", "steps": "Two concurrent SUC-01 requests", "observe": "Absolute balance overwrite may lose one update while two transactions exist", "classification": "KNOWN_DEFECT_UNCHANGED_F11_F13", "acceptance": false}
