+        .sort({ nextRefillDate: 1, _id: 1 }).limit(query.limit + 1).maxTimeMS(2000).lean().exec();
+      if (!Array.isArray(rows) || types.isProxy(rows) || Object.getPrototypeOf(rows) !== Array.prototype) throw refillUnavailable();
