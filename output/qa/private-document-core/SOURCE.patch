+      await session.endSession();
+    }
+  }
+  async ownedResource(scope: DocumentScope, tx?: Transaction): Promise<void> {
+    if (scope.resourceKind === 'unbound_upload') {
+      if (scope.resourceId !== scope.ownerUserId) throw documentError();
+      return;
+    }
+    this.connection();
