+    if (!(row._id instanceof Types.ObjectId) || row._id.toHexString() !== scope.resourceId || row.userId !== scope.ownerUserId) throw documentError();
+  }
+  async currentScope(a: FileAsset, tx?: Transaction): Promise<void> {
