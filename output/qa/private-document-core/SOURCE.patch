+  }
+  async insertAsset(a: FileAsset, tx: Transaction): Promise<void> {
+    await FileAssetModel.create([a], { session: this.session(tx) });
+  }
+  async version(a: FileAsset, id: string, tx?: Transaction): Promise<FileVersion> {
