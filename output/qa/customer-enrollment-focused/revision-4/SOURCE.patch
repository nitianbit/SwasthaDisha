+    (project / 'package-lock.json').write_text(json.dumps(seed, indent=2) + '\n')
+    def owned():
+        current = area.lstat()
+        require(current.st_dev == identity.st_dev and current.st_ino == identity.st_ino and not area.is_symlink()
