+    require(set(os.environ) <= {'PATH', 'TMPDIR', 'LANG', 'LC_CTYPE', '__CF_USER_TEXT_ENCODING'}
+            and os.environ.get('PATH') == '/usr/bin:/bin', 'Clean preparation environment')
