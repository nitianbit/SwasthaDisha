    },
    {
      "name": "Wallet",
      "collection": "wallets",
      "source": "src1/modules/wallet/model/index.ts",
      "indexes": [
        {
          "key": {
            "userId": 1
          },
          "options": {
            "unique": true
          }
        }
      ]
    },
    {
      "name": "WalletTransaction",
      "collection": "wallettransactions",
      "source": "src1/modules/wallet/model/index.ts",
      "indexes": [
        {
          "key": {
            "userId": 1,
            "transactionType": 1,
            "referenceType": 1,
            "referenceId": 1
          },
          "options": {
            "unique": true,
            "partialFilterExpression": {
              "transactionType": "refund",
              "referenceType": "pharmacy_order",
              "referenceId": {
                "$exists": true,
                "$type": "string"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Notification",
      "collection": "notifications",
      "source": "src1/modules/notification/model/index.ts",
      "indexes": [
        {
          "key": {
            "idempotencyKey": 1
          },
          "options": {
            "unique": true,
            "partialFilterExpression": {
              "idempotencyKey": {
                "$exists": true,
                "$type": "string"
              }
            }
          }
        }
      ]
    },
    {
      "name": "FcmToken",
